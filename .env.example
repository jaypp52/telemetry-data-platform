# Copy to .env (git-ignored) and adjust. Everything has a sensible default.

# Run containers as your own user so files under ./data stay yours (make sets this for you).
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Host port for the Airflow UI.
AIRFLOW_PORT=8080

# First simulated day: start date of the telemetry_backfill DAG and default for `make simulate`.
SIM_START_DATE=2026-01-01
# start_date of the hourly telemetry_pipeline DAG. `make up` fills it with today's UTC date
# when empty, so catchup only covers the live demo, not months of empty hours.
LIVE_START_DATE=

# Spark driver heap for each spark-submit (the scheduler container is capped at 5 GB).
SPARK_DRIVER_MEMORY=2g

# Live simulator (docker compose --profile live).
DEVICES=500
RATE=50

# Optional: POST a JSON summary here when a task fails (Slack-compatible {"text": ...}).
ALERT_WEBHOOK_URL=
