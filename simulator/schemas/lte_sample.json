{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telemetry/lte_sample.json",
  "title": "lte_sample",
  "description": "Cellular modem sample, every 60 s while ignition is on.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Globally unique event id (dedupe key)."
    },
    "device_id": {
      "type": "string",
      "pattern": "^dev-[0-9]{6}$",
      "description": "Device that produced the event."
    },
    "event_ts": {
      "type": "string",
      "format": "date-time",
      "description": "Device clock time of the event, ISO-8601 UTC."
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Firmware running when the event was produced."
    },
    "event_type": {
      "const": "lte_sample"
    },
    "rsrp_dbm": {
      "type": "number",
      "minimum": -140,
      "maximum": -44
    },
    "sinr_db": {
      "type": "number",
      "minimum": -20,
      "maximum": 30
    },
    "registered": {
      "type": "boolean"
    },
    "ip_assigned": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "device_id",
    "event_type",
    "event_ts",
    "firmware_version",
    "rsrp_dbm",
    "sinr_db",
    "registered",
    "ip_assigned"
  ]
}
